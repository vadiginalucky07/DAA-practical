      "source": [
        "import heapq\n",
        "\n",
        "def prim(graph, start=0):\n",
        "    visited = set()\n",
        "    min_heap = [(0, start)]  # (weight, vertex)\n",
        "    mst = []\n",
        "    total_cost = 0\n",
        "\n",
        "    while min_heap:\n",
        "        weight, u = heapq.heappop(min_heap)\n",
        "\n",
        "        if u in visited:\n",
        "            continue\n",
        "\n",
        "        visited.add(u)\n",
        "        total_cost += weight\n",
        "\n",
        "        if weight != 0:\n",
        "            mst.append((parent, u, weight))\n",
        "\n",
        "        for v, w in graph[u]:\n",
        "            if v not in visited:\n",
        "                parent = u\n",
        "                heapq.heappush(min_heap, (w, v))\n",
        "\n",
        "    return mst, total_cost\n"
      ]
    }
